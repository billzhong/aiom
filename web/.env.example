# Dashboard WebSocket URL of the AIO Monitor server, baked in at build time. Only needed when
# the dashboard is not served by aiom-server itself or from the same origin.
# Copy to `.env`, or to `.env.production.local` / `.env.development.local` for a value that only
# applies to `pnpm build` / `pnpm dev`. None of these are committed.
# Defaults to `/ws` on the server serving the page; a path like this is allowed as well.
VITE_WS_URL=wss://monitor.example.com/ws
