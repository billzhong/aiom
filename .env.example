# Configuration of the AIO Monitor server. Copy to `.env` (read from the working directory)
# or pass as environment variables. `aiom-server --help` lists the matching flags.

# Token clients authenticate with (required).
AIOM_TOKEN=change-me

# Address to listen on.
AIOM_LISTEN=0.0.0.0:3000

# Routes of the dashboard and client WebSockets.
AIOM_DASHBOARD_PATH=/ws
AIOM_AGENT_PATH=/agent

# Optional ipinfo.io token for IP geolocation beyond the anonymous rate limit.
AIOM_IPINFO_TOKEN=

# Optional directory of the built dashboard (`web/dist`, or the extracted aiom-web.tar.gz) to
# serve on all other routes. Leave empty when the dashboard is hosted elsewhere.
AIOM_WEB_DIR=

# Log filter, e.g. `info`, `debug` or `aiom_server=debug,info`.
RUST_LOG=info
